def generate_social_media_posts(analysis: Dict) -> List[Dict]:
    """Generate platform-specific social media content"""
    
    prompt = f"""
    Create 5 social media posts to promote this book:
    
    Book: {analysis.get('title', 'Untitled')}
    Genre: {analysis.get('genre', '')}
    Plot Hooks: {', '.join(analysis.get('plot_hooks', ['']))}
    Comparable Titles: {', '.join(analysis.get('comparable_titles', ['']))}
    
    For each post, provide:
    - Platform (mix of Instagram, TikTok, Twitter, Facebook)
    - Post text/caption
    - 3-5 relevant hashtags
    - Visual suggestion for the post
    
    Return as array of JSON objects with keys: platform, caption, hashtags, visual_suggestion
    """
    
    try:
        response = openai.ChatCompletion.create(
            model=st.session_state.get('model', 'gpt-4'),
            messages=[
                {"role": "system", "content": "You are a social media manager for authors."},
                {"role": "user", "content": prompt}
            ],
            temperature=0.8,
            response_format={"type": "json_object"}
        )
        
        result = json.loads(response.choices[0].message.content)
        # Handle both array and object responses
        if isinstance(result, dict) and 'posts' in result:
            return result['posts']
        elif isinstance(result, list):
            return result
        else:
            return [result]
        
    except Exception as e:
        return [{"error": str(e)}]

def generate_video_scripts(analysis: Dict) -> List[Dict]:
    """
    Generate TikTok/Reels video scripts based on manuscript analysis
    Inspired by video generation approaches in Streamlit apps [citation:2][citation:4]
    """
    
    prompt = f"""
    Create 3 TikTok/Reels video scripts (15-30 seconds each) to promote this book:
    
    Book: {analysis.get('title', 'Untitled')}
    Genre: {analysis.get('genre', '')}
    Plot Hooks: {', '.join(analysis.get('plot_hooks', ['']))}
    Tone: {analysis.get('tone', '')}
    Target Audience: {analysis.get('target_audience', '')}
    
    For each script, include:
    - Hook (first 3 seconds)
    - Visual scene description
    - Voiceover text
    - Background music suggestion
    - Call to action
    
    Follow TikTok best practices:
    - Hook in first 3 seconds
    - Fast-paced editing
    - Text overlays for key points
    - Clear CTA at end
    
    Return as array of JSON objects with keys: 
    hook, visual_scenes, voiceover, music_suggestion, cta
    """
    
    try:
        response = openai.ChatCompletion.create(
            model=st.session_state.get('model', 'gpt-4'),
            messages=[
                {"role": "system", "content": "You are a viral video content creator specializing in BookTok."},
                {"role": "user", "content": prompt}
            ],
            temperature=0.9,  # Higher temp for creative video concepts
            max_tokens=1000
        )
        
        # Parse the response (may not be JSON, could be structured text)
        content = response.choices[0].message.content
        
        # Try to parse as JSON if possible
        try:
            scripts = json.loads(content)
            return scripts if isinstance(scripts, list) else [scripts]
        except:
            # Return as text with parsing instruction
            return [{"script_text": content}]
        
    except Exception as e:
        return [{"error": str(e)}]

