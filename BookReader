def main():
    """Main application entry point"""
    
    st.title("📚 Book Marketing Engine")
    st.markdown("""
    Upload your manuscript and let AI generate a complete marketing suite:
    - **Book blurb** for Amazon product pages
    - **Email sequence** for launch campaigns  
    - **Social media posts** for multiple platforms
    - **TikTok/Reels video scripts** for BookTok promotion
    - **Ad copy** for Facebook and Amazon
    - **Author bio** for website and media kits
    """)
    
    # Setup API key
    if not setup_api_key():
        st.warning("👈 Please enter your OpenAI API key in the sidebar to begin")
        return
    
    # File upload section
    st.header("1️⃣ Upload Your Manuscript")
    
    uploaded_file = st.file_uploader(
        "Choose a file (PDF, DOCX, or TXT)",
        type=['pdf', 'docx', 'txt'],
        help="Upload your complete manuscript for AI analysis"
    )
    
    if uploaded_file:
        # Extract text
        with st.spinner("📄 Extracting text from manuscript..."):
            manuscript_text = extract_manuscript_text(uploaded_file)
        
        if manuscript_text:
            st.success(f"✅ Successfully extracted {len(manuscript_text)} characters")
            
            # Show preview
            with st.expander("Preview extracted text"):
                st.text(manuscript_text[:1000] + "..." if len(manuscript_text) > 1000 else manuscript_text)
            
            # Analyze button
            if st.button("🔍 Analyze Manuscript", type="primary"):
                analysis = analyze_manuscript(manuscript_text)
                
                if analysis:
                    st.session_state.manuscript_analysis = analysis
                    st.session_state.generated_assets = {}
                    st.success("✅ Analysis complete!")
    
    # Display analysis if available
    if st.session_state.manuscript_analysis:
        st.header("2️⃣ Manuscript Analysis")
        display_analysis(st.session_state.manuscript_analysis)
        
        # Generate assets button
        if st.button("🚀 Generate All Marketing Assets", type="primary"):
            assets = generate_all_assets(st.session_state.manuscript_analysis)
            st.session_state.generated_assets = assets
            st.rerun()
    
    # Display generated assets
    if st.session_state.generated_assets:
        st.header("3️⃣ Generated Marketing Assets")
        display_assets(st.session_state.generated_assets)
        
        # Export all button
        if st.button("📦 Export All Assets (ZIP)", type="secondary"):
            # In a real app, you'd create a ZIP file here
            st.info("ZIP export functionality would be implemented here")

