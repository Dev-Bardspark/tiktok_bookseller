def analyze_manuscript(text: str) -> Dict:
    """
    Use OpenAI to analyze the manuscript and extract key information
    Based on RAG approach described in marketing assistant guides [citation:1]
    """
    
    # Truncate text if too long (handle token limits)
    max_chars = 15000  # Approx 4000 tokens
    if len(text) > max_chars:
        text = text[:max_chars] + "... [content truncated for analysis]"
        st.warning("Manuscript truncated for API limits. Consider using GPT-3.5-16k for longer texts.")
    
    prompt = f"""
    You are a professional book editor and marketing strategist. Analyze this manuscript and extract:
    
    1. TITLE: What appears to be the book's title (or suggest one if unclear)
    2. GENRE: Primary genre and subgenres
    3. MAIN CHARACTERS: List main characters with brief descriptions
    4. CENTRAL THEMES: 3-5 core themes explored in the book
    5. TARGET AUDIENCE: Who would most enjoy this book?
    6. UNIQUE SELLING POINTS: What makes this book special/different?
    7. TONE/MOOD: The emotional atmosphere (e.g., suspenseful, humorous, melancholy)
    8. PLOT HOOKS: 3 compelling moments that would make great teasers
    9. COMPARABLE TITLES: 2-3 well-known books similar in style/theme
    
    Manuscript text:
    {text}
    
    Return your analysis as a JSON object with these keys:
    title, genre, main_characters, central_themes, target_audience, 
    unique_selling_points, tone, plot_hooks, comparable_titles
    
    For array fields, use lists. For all others, use strings.
    """
    
    try:
        with st.spinner("🧠 AI is analyzing your manuscript..."):
            response = openai.ChatCompletion.create(
                model=st.session_state.get('model', 'gpt-4'),
                messages=[
                    {"role": "system", "content": "You are a literary analyst and marketing expert. Return valid JSON only."},
                    {"role": "user", "content": prompt}
                ],
                temperature=0.3,  # Lower temp for analysis accuracy
                response_format={"type": "json_object"}
            )
        
        analysis = json.loads(response.choices[0].message.content)
        return analysis
        
    except Exception as e:
        st.error(f"Analysis failed: {str(e)}")
        return None

