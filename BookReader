def generate_book_blurb(analysis: Dict) -> str:
    """Generate Amazon-style book blurb"""
    
    prompt = f"""
    Based on this book analysis, write a compelling book blurb (150-200 words) for Amazon product pages.
    
    Book Details:
    - Title: {analysis.get('title', 'Untitled')}
    - Genre: {analysis.get('genre', 'Unknown')}
    - Main Characters: {', '.join(analysis.get('main_characters', ['']))}
    - Themes: {', '.join(analysis.get('central_themes', ['']))}
    - Tone: {analysis.get('tone', '')}
    
    The blurb should:
    - Hook readers in the first sentence
    - Introduce the protagonist and their conflict
    - Hint at stakes without spoiling
    - End with a compelling question or statement
    - Match the book's tone
    
    Return only the blurb text, no additional commentary.
    """
    
    try:
        response = openai.ChatCompletion.create(
            model=st.session_state.get('model', 'gpt-4'),
            messages=[
                {"role": "system", "content": "You are a professional copywriter specializing in book descriptions."},
                {"role": "user", "content": prompt}
            ],
            temperature=st.session_state.get('temperature', 0.7),
            max_tokens=300
        )
        
        return response.choices[0].message.content
        
    except Exception as e:
        return f"Error generating blurb: {str(e)}"

