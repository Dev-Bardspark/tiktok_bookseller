def generate_all_assets(analysis: Dict):
    """Generate all marketing assets with progress tracking"""
    
    assets = {}
    progress_bar = st.progress(0)
    status_text = st.empty()
    
    # Step 1: Book Blurb
    status_text.text("Generating book blurb...")
    assets['blurb'] = generate_book_blurb(analysis)
    progress_bar.progress(16)
    
    # Step 2: Email Sequence
    status_text.text("Creating email sequence...")
    assets['emails'] = generate_email_sequence(analysis)
    progress_bar.progress(32)
    
    # Step 3: Social Media Posts
    status_text.text("Writing social media content...")
    assets['social_posts'] = generate_social_media_posts(analysis)
    progress_bar.progress(48)
    
    # Step 4: Video Scripts
    status_text.text("Developing TikTok video concepts...")
    assets['video_scripts'] = generate_video_scripts(analysis)
    progress_bar.progress(64)
    
    # Step 5: Ad Copy
    status_text.text("Crafting advertisement copy...")
    assets['ad_copy'] = generate_ad_copy(analysis)
    progress_bar.progress(80)
    
    # Step 6: Author Bio
    status_text.text("Writing author biography...")
    assets['author_bio'] = generate_author_bio(analysis)
    progress_bar.progress(96)
    
    status_text.text("✅ All assets generated!")
    progress_bar.progress(100)
    
    time.sleep(0.5)
    status_text.empty()
    progress_bar.empty()
    
    return assets

